    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "types": "wrangler types"
  },
  "devDependencies": {
    "wrangler": "4.148.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "sharp": "^0.35.5"
  }
